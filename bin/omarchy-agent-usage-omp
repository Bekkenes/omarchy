#!/usr/bin/python3
# omarchy:summary=Print the omp (Oh My Pi) usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect omp (Oh My Pi) usage into one display-ready JSON record.

omp tracks its own usage through `omp stats --json`; this collector runs that
command and translates its output into the record contract the agents panel
reads from ~/.local/state/omarchy/agents/usage/. The panel only ever reads the
JSON this prints.

omp is provider-agnostic, so unlike the claude/codex collectors the numbers
here come from omp itself rather than any one vendor's transcript format. A
DeepSeek account (the prepaid provider omp most commonly runs on) also exposes
a live credit ledger through `get-user-balance`; when present it becomes the
panel's balance readout. DeepSeek reports only remaining credits, never the
original funding amount, so the collector surfaces `remaining` alone and the
panel shows that figure without a spend gauge.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

AGENT_ID = "omp"
AGENT_NAME = "Oh My Pi"
AUTH_HELP = "Run `omp login` to add a provider account."
DEEPSEEK_BALANCE_ENDPOINT = "https://api.deepseek.com/user/balance"


def number(value) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def local_date(timestamp_ms) -> str:
    try:
        return dt.datetime.fromtimestamp(float(timestamp_ms) / 1000.0).strftime("%Y-%m-%d")
    except Exception:
        return dt.datetime.now().strftime("%Y-%m-%d")


def empty_bucket() -> dict:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def session_counts() -> tuple[int, int]:
    """Return (today_sessions, total_sessions) from omp's session files.

    omp writes one JSONL file per session under ~/.omp/agent/sessions/. This
    is the same source `omp stats` walks, but it does not surface the session
    count, so it is counted here. A missing or unreadable directory is not an
    error: the panel simply shows 0 sessions.
    """
    root = Path.home() / ".omp" / "agent" / "sessions"
    if not root.is_dir():
        return 0, 0

    start_of_today = dt.datetime.combine(dt.datetime.now().date(), dt.time.min).timestamp()
    today = 0
    total = 0
    try:
        for path in root.rglob("*.jsonl"):
            total += 1
            try:
                if path.stat().st_mtime >= start_of_today:
                    today += 1
            except OSError:
                pass
    except OSError:
        pass
    return today, total


def empty_stats() -> dict:
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
    }


def base_record(**overrides) -> dict:
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": False,
        "hasLocalStats": False,
        "hasPromptStats": True,
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": "",
        "limits": [],
    }
    record.update(empty_stats())
    record.update(overrides)
    return record


def find_omp() -> str | None:
    """Resolve the omp binary, tolerating environments whose PATH omits mise
    shims and ~/.local/bin."""
    found = shutil.which("omp")
    if found:
        return found
    home = Path.home()
    for candidate in (
        home / ".local" / "share" / "mise" / "shims" / "omp",
        home / ".local" / "bin" / "omp",
        home / ".npm-global" / "bin" / "omp",
    ):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def run_stats(binary: str) -> dict | None:
    """Run `omp stats --json` and return the parsed object, or None on failure."""
    try:
        proc = subprocess.run(
            [binary, "stats", "--json"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
            timeout=120,
        )
    except (subprocess.TimeoutExpired, OSError):
        # A slow or missing binary must degrade to "no stats", never crash the
        # collector: the update runner treats an empty stdout as failure and
        # leaves the previous record untouched.
        return None
    if proc.returncode != 0:
        return None
    try:
        parsed = json.loads(proc.stdout)
        return parsed if isinstance(parsed, dict) else None
    except json.JSONDecodeError:
        return None


def fetch_deepseek_balance(binary: str) -> dict | None:
    """Fetch DeepSeek's live prepaid ledger for the panel's balance readout.

    DeepSeek's API is prepaid-only: `get-user-balance` returns the remaining
    granted and topped-up credits, whose sum is the current total. It does not
    report the original funding amount, so `funded` and `spent` stay 0 and the
    panel renders a plain remaining figure instead of a drain gauge. The API
    key comes from omp's own credential store (`omp token deepseek`), never
    from disk or env, so key rotation is honored. Any failure — no deepseek
    account, no network, an error status — yields no balance rather than a
    wrong number.
    """
    try:
        key = subprocess.run(
            [binary, "token", "deepseek", "--raw"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            errors="replace",
            timeout=30,
        ).stdout.strip()
    except Exception:
        return None
    if not key:
        return None

    request = urllib.request.Request(
        DEEPSEEK_BALANCE_ENDPOINT,
        headers={"Authorization": "Bearer " + key, "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            payload = json.loads(response.read().decode("utf-8", errors="replace"))
    except (urllib.error.URLError, urllib.error.HTTPError, json.JSONDecodeError, OSError):
        return None

    infos = payload.get("balance_infos") if isinstance(payload, dict) else None
    if not isinstance(infos, list) or not infos:
        return None
    info = infos[0]
    if not isinstance(info, dict):
        return None

    def money(value) -> float:
        try:
            n = float(value)
            return n if n == n else 0.0
        except (TypeError, ValueError):
            return 0.0

    # total_balance, granted_balance, and topped_up_balance are all *remaining*
    # credits, and granted + topped_up sums to total. There is no original
    # funding figure, so "spent" is unknowable from this endpoint: report
    # remaining only and leave funded/spent at 0, which the panel reads as a
    # plain remaining readout rather than a gauge that can never drain. A zero
    # total is a valid exhausted state and must still surface as a balance.
    total = money(info.get("total_balance"))
    currency = str(info.get("currency") or "USD").upper() or "USD"
    return {
        "remaining": total,
        "funded": 0.0,
        "spent": 0.0,
        "currency": currency,
        "estimated": False,
    }


def summarize(data: dict) -> dict:
    overall = data.get("overall") or {}
    if not isinstance(overall, dict):
        return empty_stats()

    total_requests = number(overall.get("totalRequests"))

    # Per-model all-time buckets, straight off byModel.
    model_usage: dict = {}
    by_model = data.get("byModel") or []
    for entry in by_model:
        if not isinstance(entry, dict):
            continue
        model = str(entry.get("model") or "omp")
        bucket = empty_bucket()
        bucket["inputTokens"] = number(entry.get("totalInputTokens"))
        bucket["outputTokens"] = number(entry.get("totalOutputTokens"))
        bucket["cacheReadInputTokens"] = number(entry.get("totalCacheReadTokens"))
        bucket["cacheCreationInputTokens"] = number(entry.get("totalCacheWriteTokens"))
        model_usage[model] = bucket

    # Daily series: one entry per day, {timestamp, requests, errors, tokens}.
    by_date: dict[str, int] = {}
    active_dates: set[str] = set()
    for entry in data.get("timeSeries") or []:
        if not isinstance(entry, dict):
            continue
        day = local_date(entry.get("timestamp"))
        tokens = number(entry.get("tokens"))
        by_date[day] = by_date.get(day, 0) + tokens
        if number(entry.get("requests")) > 0 or tokens > 0:
            active_dates.add(day)

    today = dt.datetime.now().strftime("%Y-%m-%d")
    recent_dates = [
        (dt.datetime.now() - dt.timedelta(days=offset)).strftime("%Y-%m-%d")
        for offset in range(6, -1, -1)
    ]
    recent_days = [
        {"date": day, "messageCount": by_date.get(day, 0)} for day in recent_dates
    ]

    today_sessions, total_sessions = session_counts()

    return {
        "todayPrompts": number(
            next(
                (e.get("requests") for e in data.get("timeSeries") or []
                 if isinstance(e, dict) and local_date(e.get("timestamp")) == today),
                0,
            )
        ),
        "todaySessions": today_sessions,
        "todayTotalTokens": by_date.get(today, 0),
        "todayTokensByModel": {},
        "recentDays": recent_days,
        "totalPrompts": total_requests,
        "totalSessions": total_sessions,
        "activeDays": len(active_dates),
        "activeDates": sorted(active_dates),
        "modelUsage": model_usage,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    # omp stats has no cache to force past and no cheaper limits-only path;
    # the flags exist so the collector accepts the same invocation the update
    # command gives every collector.
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    args = parser.parse_args()

    binary = find_omp()
    if not binary:
        record = base_record(usageStatusText="omp unavailable", authHelpText="omp not found in PATH")
        print(json.dumps(record, separators=(",", ":"), sort_keys=True))
        return 0

    data = run_stats(binary)
    if data is None:
        record = base_record(usageStatusText="omp stats unavailable", authHelpText=AUTH_HELP)
        print(json.dumps(record, separators=(",", ":"), sort_keys=True))
        return 0

    stats = summarize(data)
    record = base_record(
        ready=number(stats["totalPrompts"]) > 0,
        hasLocalStats=True,
    )
    record.update(stats)

    # A prepaid ledger only makes sense when omp actually runs on a provider
    # that bills that way; DeepSeek is the one whose balance endpoint is open
    # to API keys.
    providers = {
        str(e.get("provider") or "")
        for e in (data.get("byModel") or [])
        if isinstance(e, dict)
    }
    if "deepseek" in providers:
        balance = fetch_deepseek_balance(binary)
        if balance is not None:
            record["balance"] = balance
            record["tierLabel"] = "Prepaid"

    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
